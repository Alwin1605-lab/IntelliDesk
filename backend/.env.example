# Backend Environment Variables
PORT=5000
MONGODB_URI=mongodb://localhost:27017/ticketiq
JWT_SECRET=ticketiq_super_secret_jwt_key_2024
JWT_EXPIRES_IN=7d

# ML Service
ML_SERVICE_URL=http://localhost:5001

# SMTP Configuration (Real SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=TicketIQ <noreply@ticketiq.com>

# SLA Defaults (in minutes)
SLA_CRITICAL_RESPONSE=15
SLA_CRITICAL_RESOLUTION=120
SLA_HIGH_RESPONSE=30
SLA_HIGH_RESOLUTION=480
SLA_MEDIUM_RESPONSE=60
SLA_MEDIUM_RESOLUTION=1440
SLA_LOW_RESPONSE=240
SLA_LOW_RESOLUTION=2880
